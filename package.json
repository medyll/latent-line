{
	"name": "latent-line",
	"private": true,
	"version": "0.4.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5167",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --ignore-pattern '**/*.test.*'",
		"lint:fix": "prettier --write . && eslint . --fix --ignore-pattern '**/*.test.*'",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright test",
		"server:dev": "pnpm --dir server run dev",
		"server:build": "pnpm --dir server run build",
		"server:test": "pnpm --dir server run test",
		"server:start": "pnpm --dir server run start",
		"test:visual": "node scripts/visual-regression.mjs",
		"test:unit:coverage": "vitest run --coverage",
		"test:visual:update": "node scripts/visual-regression.mjs update",
		"bmad:update-dashboard": "node .github/skills/bmad-master/scripts/bmad.mjs dashboard",
		"capture:screenshots": "node scripts/capture-screenshots.mjs",
		"check:i18n": "node scripts/check-i18n.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^25.9.8",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"autoprefixer": "^10.6.1",
		"bits-ui": "^2.19.3",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"formsnap": "^2.0.1",
		"globals": "^17.12.0",
		"layerchart": "2.0.0-next.43",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"playwright": "^1.63.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"shadcn": "^4.21.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.5",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.1",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"@medyll/css-base": "^0.6.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"pixelmatch": "^7.2.0",
		"shadcn-svelte": "^1.7.0",
		"zod": "^4.6.5"
	}
}
