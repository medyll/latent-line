# Environment configuration for latent-line
# Copy to .env.local and fill with real values; do NOT commit .env.local
VITE_API_URL=https://api.example.com
VITE_MODEL_CHECKPOINT=flux_dev.safetensors
VITE_DEFAULT_SEED=42
VITE_TTS_ENGINE=elevenlabs_v2

# Latent-line server (server/)
PORT=8080
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_MS=15000
RENDER_API_TOKEN=replace-with-a-long-random-token
ALLOWED_ORIGINS=http://localhost:5167
RENDER_WORKFLOW_DIR=./workflows
RENDER_JOB_STORE=./data/render-jobs.json
RENDER_MAX_ACTIVE_JOBS=2
RENDER_MAX_BODY_BYTES=20000000

# Latent-line server (server/)
PORT=8080
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_MS=15000
RENDER_API_TOKEN=replace-with-a-long-random-token
ALLOWED_ORIGINS=http://localhost:5167
RENDER_WORKFLOW_DIR=./workflows
RENDER_JOB_STORE=./data/render-jobs.json
RENDER_MAX_ACTIVE_JOBS=2
