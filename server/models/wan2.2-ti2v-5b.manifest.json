{
	"id": "wan2.2-ti2v-5b",
	"version": "1.0.0",
	"label": "Wan 2.2 TI2V-5B (local)",
	"description": "Unified text-to-video and image-to-video Diffusers pipeline. Lowest VRAM bar of the Wan 2.2 family (~8 GB), runs on the render worker's own GPU.",
	"mode": "text-to-video",
	"entrypoint": "wan2.2-ti2v-5b",
	"vramMinGb": 8,
	"inputs": {
		"positive_prompt": { "type": "string", "required": true },
		"negative_prompt": { "type": "string", "required": false, "default": "" },
		"seed": { "type": "integer", "required": false, "default": -1 },
		"width": { "type": "integer", "required": false, "default": 1280, "min": 64, "max": 1920 },
		"height": { "type": "integer", "required": false, "default": 704, "min": 64, "max": 1920 },
		"frame_count": { "type": "integer", "required": false, "default": 121, "min": 9, "max": 241 },
		"fps": { "type": "integer", "required": false, "default": 24, "min": 8, "max": 60 },
		"start_image": { "type": "string", "required": false }
	}
}
