{
	"id": "wan21-t2v-1.3b",
	"version": "1.0.0",
	"label": "Wan 2.1 T2V 1.3B",
	"description": "Development text-to-video workflow",
	"mode": "text-to-video",
	"workflowFile": "wan21-t2v.workflow.json",
	"outputNodeIds": ["OUTPUT_NODE_ID"],
	"inputs": {
		"positive_prompt": {
			"nodeId": "POSITIVE_PROMPT_NODE_ID",
			"input": "text",
			"type": "string",
			"required": true
		},
		"negative_prompt": {
			"nodeId": "NEGATIVE_PROMPT_NODE_ID",
			"input": "text",
			"type": "string",
			"default": ""
		},
		"seed": {
			"nodeId": "SAMPLER_NODE_ID",
			"input": "seed",
			"type": "integer",
			"required": true,
			"min": 0
		},
		"width": {
			"nodeId": "LATENT_NODE_ID",
			"input": "width",
			"type": "integer",
			"default": 832,
			"min": 256,
			"max": 1280
		},
		"height": {
			"nodeId": "LATENT_NODE_ID",
			"input": "height",
			"type": "integer",
			"default": 480,
			"min": 256,
			"max": 1280
		},
		"frame_count": {
			"nodeId": "LATENT_NODE_ID",
			"input": "length",
			"type": "integer",
			"default": 81,
			"min": 1,
			"max": 161
		},
		"fps": {
			"nodeId": "OUTPUT_NODE_ID",
			"input": "frame_rate",
			"type": "number",
			"default": 16,
			"min": 1,
			"max": 60
		}
	}
}
